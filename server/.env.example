# Chaîne de connexion PostgreSQL
DATABASE_URL="postgresql://olikrys:olikrys@localhost:5432/olikrys?schema=public"

# Port de l'API
PORT=4000

# Origines autorisées pour le frontend, séparées par des virgules.
# Obligatoire en production : sans cette variable, l'API refuse de démarrer.
CLIENT_ORIGIN="http://localhost:5173"

# Mettre à true uniquement si le front et l'API sont sur deux domaines différents.
# Le cookie de session passe alors en SameSite=None + Secure (HTTPS obligatoire).
CROSS_SITE_COOKIE=false

# Nombre de reverse proxies devant l'API (Nginx, Render, Railway… : généralement 1).
# Indispensable pour que la limitation de tentatives voie la vraie IP du visiteur.
# À laisser à 0 si l'API est exposée directement : sinon l'en-tête X-Forwarded-For
# devient falsifiable et la limite contournable.
TRUST_PROXY=0

# Compte administrateur (créé ou mis à jour au démarrage de l'API).
# ADMIN_USERNAME permet de se connecter avec un pseudo au lieu de l'e-mail.
# En production, ADMIN_PASSWORD doit faire au moins 12 caractères.
ADMIN_EMAIL="olykris@olikrys.local"
ADMIN_USERNAME="olykris"
ADMIN_PASSWORD="change-moi-en-production"
ADMIN_NAME="Olykris"
