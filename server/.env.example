# ──────────────────────────────────────────────────────────────────────────────
# Configuration de l'API OliKrys
#
# En local : copier ce fichier en `.env` et adapter les valeurs.
# En production (Render) : ne pas déposer de fichier, saisir ces variables dans
# l'onglet Environment du service. `.env` est ignoré par git, jamais committé.
# ──────────────────────────────────────────────────────────────────────────────

# Chaîne de connexion PostgreSQL.
# Neon (production) : copier la chaîne « pooled » depuis la console, avec sslmode=require.
DATABASE_URL="postgresql://olikrys:olikrys@localhost:5432/olikrys?schema=public"

# Port de l'API. Sur Render, la plateforme l'injecte elle-même : ne pas le définir.
PORT=4000

# Origines autorisées pour le site, séparées par des virgules.
# Obligatoire en production : sans cette variable, l'API refuse de démarrer.
# Valeur = le domaine exact du site, sans barre finale (elle serait retirée de
# toute façon, mais autant la donner propre) :
#   CLIENT_ORIGIN="https://olikrys.vercel.app,https://olikrys.art"
# Attention : les déploiements de prévisualisation Vercel ont une URL différente
# à chaque branche ; ils seront bloqués tant qu'ils ne figurent pas dans la liste.
CLIENT_ORIGIN="http://localhost:5173"

# true uniquement si le site et l'API sont sur deux domaines différents
# (Vercel + Render, par exemple). Le cookie de session passe alors en
# SameSite=None + Secure, ce qui impose HTTPS des deux côtés.
# Laisser false si tout est servi par le même domaine.
CROSS_SITE_COOKIE=false

# Nombre de reverse proxies devant l'API. Render, Railway, Nginx : 1.
# À laisser à 0 si l'API est exposée directement : sinon l'en-tête X-Forwarded-For
# devient falsifiable et la limitation de tentatives contournable.
TRUST_PROXY=0

# Compte administrateur, recréé ou mis à jour à chaque démarrage de l'API.
# ADMIN_USERNAME permet de se connecter avec un pseudo au lieu de l'e-mail :
# 3 à 40 caractères parmi a-z, 0-9, point, tiret et souligné.
# En production, ADMIN_PASSWORD doit faire au moins 12 caractères, sinon l'API
# refuse de démarrer.
ADMIN_EMAIL="olykris@olikrys.local"
ADMIN_USERNAME="olykris"
ADMIN_PASSWORD="change-moi-en-production"
ADMIN_NAME="Olykris"
