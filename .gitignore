node_modules/
dist/
.env
*.log
.DS_Store

# Artefacts de build incrémental TypeScript (propres à chaque machine)
*.tsbuildinfo

# Masters audio non compressés : trop volumineux pour un dépôt git.
# Seuls les fichiers web convertis (client/public/audio/*.mp3, *.ogg) sont versionnés.
*.wav
*.aiff
*.flac

# Notes de séance : contiennent des identifiants en clair, ne doivent jamais partir sur GitHub
sceance*.md

# Médias sources : les masters audio restent locaux (voir medias-sources/README.md).
# Les images d'origine, légères, sont versionnées.
medias-sources/audio/*
!medias-sources/audio/.gitkeep
